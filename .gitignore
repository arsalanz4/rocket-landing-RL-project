# Model artifacts: ignore all zip/pkl EXCEPT the current best_model +
# vec_normalize pair, which is the one thing meant to be pushed/pulled for
# cross-machine handoff. Kept small because SyncSaveCallback overwrites these
# two files in place during training instead of accumulating new ones.
*.zip
*.pkl
!best_model.zip
!vec_normalize.pkl

# Checkpoint directory (numbered snapshots, can be hundreds of files) --
# local-only rollback safety net, not needed for cross-machine sync.
checkpoints/

# TensorBoard logs
logs/

# Python cache
__pycache__/
*.pyc
*.pyo
